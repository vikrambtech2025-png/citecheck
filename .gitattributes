# Normalise line endings so the repo behaves the same on Windows, macOS and
# Linux. Without this, every checkout on Windows rewrites LF as CRLF and the
# working tree is permanently dirty.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.lock  text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary: never touched.
*.sqlite3 binary
*.db      binary
*.png     binary
*.jpg     binary
*.pdf     binary