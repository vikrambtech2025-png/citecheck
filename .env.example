# Copy to .env and edit. Every key is optional -- defaults target local Ollama.

# ---------- Model backend ----------
# ollama | openai_compat | openai | anthropic | mock
CITECHECK_MODEL_BACKEND=ollama
CITECHECK_OLLAMA_MODEL=qwen2.5:7b-instruct
CITECHECK_OLLAMA_BASE_URL=http://localhost:11434/v1

# Hosted providers -- only needed for an optional polished demo run.
# CITECHECK_MODEL_BACKEND=anthropic
# CITECHECK_ANTHROPIC_API_KEY=sk-ant-...
# CITECHECK_ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- Tracing ----------
# CITECHECK_TRACING_BACKEND=langfuse
# CITECHECK_LANGFUSE_PUBLIC_KEY=pk-lf-...
# CITECHECK_LANGFUSE_SECRET_KEY=sk-lf-...
# CITECHECK_LANGFUSE_HOST=http://localhost:3000

# ---------- Sampling ----------
CITECHECK_TEMPERATURE=0.0
CITECHECK_MAX_STEPS=12
CITECHECK_MAX_TOOL_CALLS=40

# ---------- Sandbox ----------
# Leave false. Setting it true disables the SSRF guard on fetch_url.
CITECHECK_ALLOW_PRIVATE_NETWORK=false